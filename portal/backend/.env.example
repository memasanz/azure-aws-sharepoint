# Pinned APIM managed identity application (client) id — the ONLY grant target.
APIM_MI_APP_ID=REPLACE_WITH_APIM_MI_APP_ID
APIM_MI_DISPLAY_NAME=APIM SharePoint Reader

# Entra tenant (informational).
TENANT_ID=REPLACE_WITH_TENANT_ID

# React dev server origin (CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Grant registry location.
GRANT_DB_PATH=grants.db
